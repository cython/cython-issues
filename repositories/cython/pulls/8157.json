            "author_association": "MEMBER",
            "body": "Passing `log` into these functions doesn't really make sense to me.",
            "commit_id": "699f85f244b9b6ee63e1d5b20f7cb22734fc5429",
            "copilot_code_review_severity": null,
            "copilot_code_review_sources": [],
            "created_at": "2026-11-24T20:18:12Z",
            "diff_hunk": "@@ -0,0 +1,176 @@\n+# mode: run\n+# ticket: 8156\n+\n+# cython: freethreading_compatible=True\n+\n+# Every way out of a \"with cython.critical_section(...)\" or \"with lock:\" block\n+# must release the references that the block keeps to its arguments, and only\n+# after the critical section or the lock has been released.\n+\n+cimport cython\n+\n+cdef extern from *:\n+    \"\"\"\n+    #if CYTHON_COMPILING_IN_CPYTHON_FREETHREADING\n+    /* Is the per-object lock that critical sections use still held? */\n+    static int object_lock_held(PyObject *o) {\n+    #if PY_VERSION_HEX >= 0x030e00C1\n+        return PyMutex_IsLocked(&o->ob_mutex);\n+    #else\n+        return _Py_atomic_load_uint8_relaxed(&o->ob_mutex._bits) & _Py_LOCKED;\n+    #endif\n+    }\n+    #else\n+    #define object_lock_held(o) ((void)(o), 0)\n+    #endif\n+    \"\"\"\n+    bint object_lock_held(object o)\n+\n+\n+cdef class Tracked:\n+    \"\"\"\n+    Logs its release, and whether a critical section on it or its own lock\n+    was still held at that point.\n+    \"\"\"\n+    cdef cython.pymutex lock\n+    cdef list log\n+\n+    def __cinit__(self, list log):\n+        self.log = log\n+\n+    def __dealloc__(self):\n+        if object_lock_held(self) or self.lock.locked():\n+            self.log.append(\"released while locked\")\n+        else:\n+            self.log.append(\"released\")\n+\n+\n+def break_from_section_on_argument(obj, list log):",
            "html_url": "https://github.com/cython/cython/pull/8157#discussion_r4685980190",
