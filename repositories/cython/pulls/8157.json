            "diff_hunk": "@@ -9456,7 +9457,35 @@ def generate_execution_code(self, code):\n         code.put_ensure_gil(declare_gilstate=False)\n \n \n-class CriticalSectionStatNode(TryFinallyStatNode):\n+class ArgsReleasedInFinallyMixin:\n+    \"\"\"\n+    For try-finally statements that must keep their arguments alive until their\n+    finally clause has run: critical sections lock their argument objects, and a\n+    lock may live inside an object that only a temp keeps alive.  The finally\n+    clause disposes of the arguments on every way out of the body (including\n+    break, continue and return), so return statements must leave their temps alone.\n+    \"\"\"\n+\n+    def generate_args_evaluation_code(self, code, args):\n+        \"\"\"\n+        Returns the temps holding references that the finally clause releases.\n+        \"\"\"\n+        funcstate = code.funcstate\n+        held_before = {cname for cname, _ in funcstate.temps_holding_reference()}\n+        for arg in args:\n+            arg.generate_evaluation_code(code)\n+        temps = {cname for cname, _ in funcstate.temps_holding_reference()} - held_before",
