            "diff_hunk": "@@ -0,0 +1,16 @@\n+Cython type,Pure Python type\n+``object``,``object``\n+``cython.py_int``,``int``\n+``cython.py_float``,``float``\n+``cython.py_bool``,``bool``\n+``cython.py_complex``,``complex``\n+``bytes``,``bytes``\n+``bytearray``,``bytearray``\n+``str``,``str``\n+``memoryview``,``memoryview``\n+``list``,``list``\n+``tuple``,``tuple``\n+``set``,``set``\n+``frozenset``,``frozenset``\n+``dict``,``dict``\n+``frozendict``,``frozendict``",
