            "author_association": "MEMBER",
            "body": "You can add the following factory method to the `TupleNode` class to move the whole ctuple creation into a cleaner API and keep the dependencies between node classes low:\r\n```patch\r\ndiff --git a/Cython/Compiler/ExprNodes.py b/Cython/Compiler/ExprNodes.py\r\nindex 763090a78..f35c8648d 100644\r\n--- a/Cython/Compiler/ExprNodes.py\r\n+++ b/Cython/Compiler/ExprNodes.py\r\n@@ -9217,6 +9217,11 @@ class TupleNode(SequenceNode):\r\n \r\n     gil_message = \"Constructing Python tuple\"\r\n \r\n+    @classmethod\r\n+    def for_ctuple(cls, pos, args, ctuple_type, env):\r\n+        assert len(args) > 0\r\n+        return cls(pos, args=args).coerce_to_ctuple(ctuple_type, env)\r\n+\r\n     def infer_type(self, env):\r\n         if self.mult_factor or not self.args:\r\n             return tuple_type\r\n```",
            "commit_id": "bf9bf6dcd534302e87759ed00e9772fe71846542",
            "copilot_code_review_sources": [],
            "created_at": "2026-11-03T09:43:01Z",
            "diff_hunk": "@@ -12235,6 +12238,33 @@ def analyse_types(self, env):\n                         \"Casting a GIL-requiring function into a nogil function circumvents GIL validation\", 1)\n         return self\n \n+    def analyse_ctuple_cast(self, env):\n+        # A C tuple is a struct, which C cannot cast directly.\n+        # Cast each item instead: (<T1>t[0], <T2>t[1], ...)\n+        operand_type = self.operand.type\n+        if operand_type.size != self.type.size:\n+            error(self.pos, f\"Cannot cast '{operand_type}' to '{self.type}'\")\n+            self.type = PyrexTypes.error_type\n+            return self\n+\n+        from .UtilNodes import EvalWithTempExprNode, ResultRefNode\n+        operand_ref = ResultRefNode(self.operand)\n+        items = [\n+            TypecastNode(\n+                self.pos,\n+                operand=IndexNode(\n+                    self.pos,\n+                    base=operand_ref,\n+                    index=IntNode(self.pos, value=str(i), constant_result=i, type=PyrexTypes.c_py_ssize_t_type),\n+                ),\n+                type=item_type,\n+                typecheck=self.typecheck,\n+            )\n+            for i, item_type in enumerate(self.type.components)\n+        ]\n+        node = TupleNode(self.pos, args=items).analyse_types(env).coerce_to(self.type, env)\n+        return EvalWithTempExprNode(operand_ref, node)",
            "html_url": "https://github.com/cython/cython/pull/8086#discussion_r4453018211",
