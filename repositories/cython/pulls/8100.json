    "body": "Fixes #8098\n\nThey were being appended instead of being replaced",
    "closed_at": "2026-11-02T14:02:41Z",
    "comment_data": [
        {
            "_links": {
                "html": {
                    "href": "https://github.com/cython/cython/pull/8100#discussion_r4437223652"
                },
                "pull_request": {
