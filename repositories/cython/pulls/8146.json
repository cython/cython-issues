                },
                "self": {
                    "href": "https://api.github.com/repos/cython/cython/pulls/comments/4626694150"
                }
            },
            "author_association": "MEMBER",
            "body": "This is essentially duplicated code, but it doesn't look the same as `.is_python_comparison()`. It probably should be just that.",
            "commit_id": "cc76c8bf3f50d6e9cf9d6a1f7f14f991e0793346",
            "copilot_code_review_severity": null,
            "copilot_code_review_sources": [],
            "created_at": "2026-11-19T09:25:27Z",
            "diff_hunk": "@@ -14258,6 +14258,19 @@ class CmpNode:\n     special_bool_cmp_utility_code = None\n     special_bool_extra_args = []\n \n+    def needs_gil(self):\n+        # Optimised comparisons call into the Python C-API even when their\n+        # result is a C bint, so they require the GIL.  \"is\" comparisons and\n+        # memoryview None checks only compare pointers, and \"in\" checks on\n+        # C pointers are transformed into C loops.\n+        if self.special_bool_cmp_function:\n+            return True\n+        if self.operator in ('is', 'is_not') or self.is_ptr_contains():\n+            return False\n+        if getattr(self, 'is_memslice_nonecheck', False):\n+            return False\n+        return self.has_python_operands()",
            "html_url": "https://github.com/cython/cython/pull/8146#discussion_r4626694150",
