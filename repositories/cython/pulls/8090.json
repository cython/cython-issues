                },
                "self": {
                    "href": "https://api.github.com/repos/cython/cython/pulls/comments/4405097986"
                }
            },
            "author_association": "MEMBER",
            "body": "Based on the documentation, the might be a different error on Windows if the file is being read by something else (but probably not on unix).",
            "commit_id": "2355adf4898d0c0db32cf700d80021ed795607c9",
            "copilot_code_review_sources": [],
            "created_at": "2026-10-28T19:23:48Z",
            "diff_hunk": "@@ -171,28 +174,68 @@ def store_to_cache(self, c_file, fingerprint, compilation_result):\n                     zip.write(artifact, os.path.basename(artifact))\n         os.rename(fingerprint_file + \".tmp\", fingerprint_file)\n \n-    def cleanup_cache(self, ratio=0.85):\n+    def _list_cache_files(self):\n+        total_size = 0\n+        cache_files = []\n+        with os.scandir(self.path) as entries:\n+            for entry in entries:\n+                if entry.name.endswith('.tmp'):\n+                    # Ignore temp files that might still be used by other Cython processes.\n+                    continue\n+                try:\n+                    stat = entry.stat(follow_symlinks=False)\n+                except FileNotFoundError:\n+                    # File was removed concurrently.\n+                    continue\n+\n+                file_size = stat.st_size\n+                total_size += file_size\n+                cache_files.append((entry.path, file_size, stat.st_atime))\n+\n+        return total_size, cache_files\n+\n+    def _sort_files_by_atime(self, cache_files):\n+        cache_files.sort(key=operator.itemgetter(2, 1))\n+\n+    def _delete_cache_files(self, files_to_delete, total_size, max_cache_size):\n+        for file_path, size, _ in files_to_delete:\n+            if total_size < max_cache_size:\n+                return\n+            try:\n+                os.unlink(file_path)\n+            except FileNotFoundError:\n+                # Concurrently deleted. Nothing left to delete for us.\n+                pass",
